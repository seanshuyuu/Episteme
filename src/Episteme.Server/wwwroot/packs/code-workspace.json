{
  "$schema": "https://episteme.local/schema/pack/v1",
  "id": "pack_code-workspace",
  "name": "个人代码管理工作空间",
  "version": "1.0.0",
  "episteme": ">=0.5.0",
  "description": "面向个人代码资产的声明式工作空间：按桌面端 / 移动端 / 跨平台 / 前后端分离四类软件应用组织项目，配合 tools/git-sync.py 的旁路同步把 git push 的提交、元数据与变更文件内容归档到对应类型节点，四类阅读器提供代码文件的在线预览。",
  "author": "Episteme",
  "sampleData": true,
  "nodes": [
    {
      "path": "/代码项目",
      "contentType": null,
      "icon": "folder",
      "exposeToMcp": true
    },
    {
      "path": "/代码项目/桌面端",
      "contentType": "software_project",
      "icon": "desktop",
      "exposeToMcp": true
    },
    {
      "path": "/代码项目/移动端",
      "contentType": "software_project",
      "icon": "smartphone",
      "exposeToMcp": true
    },
    {
      "path": "/代码项目/跨平台",
      "contentType": "software_project",
      "icon": "layers",
      "exposeToMcp": true
    },
    {
      "path": "/代码项目/前后端分离",
      "contentType": "software_project",
      "icon": "split",
      "exposeToMcp": true
    },
    {
      "path": "/Git 提交",
      "contentType": "git_commit",
      "icon": "git-commit",
      "defaultPartKinds": ["md", "code"],
      "exposeToMcp": true
    },
    {
      "path": "/Git 提交/桌面端",
      "contentType": "git_commit",
      "icon": "desktop",
      "defaultPartKinds": ["md", "code"],
      "exposeToMcp": true
    },
    {
      "path": "/Git 提交/移动端",
      "contentType": "git_commit",
      "icon": "smartphone",
      "defaultPartKinds": ["md", "code"],
      "exposeToMcp": true
    },
    {
      "path": "/Git 提交/跨平台",
      "contentType": "git_commit",
      "icon": "layers",
      "defaultPartKinds": ["md", "code"],
      "exposeToMcp": true
    },
    {
      "path": "/Git 提交/前后端分离",
      "contentType": "git_commit",
      "icon": "split",
      "defaultPartKinds": ["md", "code"],
      "exposeToMcp": true
    },
    {
      "path": "/在线预览",
      "contentType": "code_snapshot",
      "icon": "eye",
      "defaultPartKinds": ["code", "md", "web"],
      "exposeToMcp": true
    }
  ],
  "contentTypes": [
    {
      "slug": "software_project",
      "label": "软件项目",
      "icon": "package",
      "version": 1,
      "exposeToMcp": true,
      "mcpToolPrefix": "project",
      "primaryField": "title",
      "titleTemplate": "{{title}}",
      "defaultPartKinds": ["md"],
      "fields": [
        { "key": "title", "label": "项目名称", "type": "text", "required": true, "indexed": true, "exposeToMcp": true, "mcpWritable": true, "validation": { "maxLength": 200 } },
        { "key": "appType", "label": "应用类型", "type": "select", "required": true, "indexed": true, "exposeToMcp": true, "mcpWritable": true, "options": ["桌面端", "移动端", "跨平台", "前后端分离"] },
        { "key": "repoUrl", "label": "Git 仓库", "type": "text", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true, "hint": "兼容 git@host:repo.git 这类 SSH 远程，故用 text 而非 url" },
        { "key": "techStack", "label": "技术栈", "type": "tags", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true, "hint": "例如 [\"Avalonia\", \".NET 10\", \"PostgreSQL\"]" },
        { "key": "mainLanguage", "label": "主语言", "type": "text", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "status", "label": "状态", "type": "select", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true, "options": ["开发中", "维护中", "已归档", "实验"], "defaultValue": "开发中" },
        { "key": "description", "label": "项目说明", "type": "longtext", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitSyncNode", "label": "提交归档目录", "type": "text", "required": false, "exposeToMcp": true, "mcpWritable": true, "hint": "git-sync.py --node-path 指向的节点，例如 /Git 提交/桌面端" },
        { "key": "lastSyncAt", "label": "最近同步", "type": "text", "required": false, "exposeToMcp": true, "mcpWritable": true }
      ],
      "views": [
        { "name": "全部项目", "filter": {}, "sort": [{ "field": "updatedAt", "desc": true }] }
      ]
    },
    {
      "slug": "git_commit",
      "label": "Git 提交",
      "icon": "git-commit",
      "version": 1,
      "exposeToMcp": true,
      "mcpToolPrefix": "gitcommit",
      "primaryField": "title",
      "titleTemplate": "{{title}}",
      "defaultPartKinds": ["md", "code"],
      "fields": [
        { "key": "title", "label": "标题", "type": "text", "required": true, "indexed": true, "exposeToMcp": true, "mcpWritable": true, "validation": { "maxLength": 300 } },
        { "key": "gitSha", "label": "Commit SHA", "type": "text", "required": true, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitShortSha", "label": "短 SHA", "type": "text", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitRepo", "label": "远程仓库", "type": "text", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitBranch", "label": "分支", "type": "text", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitTag", "label": "标签", "type": "text", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitAuthorName", "label": "作者", "type": "text", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitAuthorEmail", "label": "作者邮箱", "type": "text", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitAuthorDate", "label": "作者时间", "type": "text", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitCommitter", "label": "提交者", "type": "text", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitMessage", "label": "提交说明", "type": "text", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitBody", "label": "说明正文", "type": "longtext", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitChangedFiles", "label": "变更文件", "type": "json", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitDiff", "label": "Diff", "type": "longtext", "required": false, "exposeToMcp": false, "mcpWritable": true },
        { "key": "gitFileContents", "label": "文件内容索引", "type": "json", "required": false, "exposeToMcp": false, "mcpWritable": true },
        { "key": "gitPartCount", "label": "导入 Part 数", "type": "number", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitSyncSource", "label": "同步来源", "type": "text", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "appType", "label": "应用类型", "type": "select", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true, "options": ["桌面端", "移动端", "跨平台", "前后端分离"] },
        { "key": "projectName", "label": "所属项目", "type": "text", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "gitSyncNode", "label": "归档节点", "type": "text", "required": false, "exposeToMcp": true, "mcpWritable": true }
      ],
      "views": [
        { "name": "全部提交", "filter": {}, "sort": [{ "field": "updatedAt", "desc": true }] }
      ]
    },
    {
      "slug": "code_snapshot",
      "label": "代码在线预览",
      "icon": "eye",
      "version": 1,
      "exposeToMcp": true,
      "mcpToolPrefix": "codesnapshot",
      "primaryField": "title",
      "titleTemplate": "{{title}}",
      "defaultPartKinds": ["code"],
      "fields": [
        { "key": "title", "label": "标题", "type": "text", "required": true, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "appType", "label": "应用类型", "type": "select", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true, "options": ["桌面端", "移动端", "跨平台", "前后端分离"] },
        { "key": "projectName", "label": "所属项目", "type": "text", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "sourceCommit", "label": "来源提交", "type": "text", "required": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "summary", "label": "说明", "type": "longtext", "required": false, "exposeToMcp": true, "mcpWritable": true }
      ],
      "views": [
        { "name": "全部预览", "filter": {}, "sort": [{ "field": "updatedAt", "desc": true }] }
      ]
    }
  ],
  "sampleDocuments": [
    {
      "node": "/代码项目/桌面端",
      "type": "software_project",
      "title": "示例 · 桌面端应用",
      "fields": {
        "title": "示例 · 桌面端应用",
        "appType": "桌面端",
        "techStack": ["Avalonia", ".NET 10"],
        "mainLanguage": "C#",
        "status": "开发中",
        "description": "把仓库归档到 /Git 提交/桌面端：git-sync.py --app-type desktop --node-path \"/Git 提交/桌面端\"",
        "gitSyncNode": "/Git 提交/桌面端"
      },
      "parts": [
        { "kind": "md", "content": "# 示例 · 桌面端应用\n\n这是一个 Pack 示例项目，可删除。四类应用目录共用 `software_project` Schema，`appType` 决定它属于哪一类。" }
      ]
    },
    {
      "node": "/代码项目/前后端分离",
      "type": "software_project",
      "title": "示例 · 前后端分离应用",
      "fields": {
        "title": "示例 · 前后端分离应用",
        "appType": "前后端分离",
        "techStack": ["ASP.NET Core", "Blazor", "PostgreSQL"],
        "mainLanguage": "C# / TypeScript",
        "status": "维护中",
        "description": "前端与后端分别提交时，用 --app-type fullstack 归档到同一类型节点。",
        "gitSyncNode": "/Git 提交/前后端分离"
      },
      "parts": [
        { "kind": "md", "content": "# 示例 · 前后端分离应用\n\n在线预览：打开任一 Git 提交文档，Part 标签会显示文件路径与语言，代码由 Monaco 高亮渲染。" }
      ]
    }
  ],
  "views": [],
  "prompts": [],
  "jobs": []
}
