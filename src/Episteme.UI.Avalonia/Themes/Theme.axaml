<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Microsoft YaHei, PingFang SC, Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Border.card">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="Button.theme">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <Style Selector="Button.action">
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas, Menlo, monospace"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
</Styles>
