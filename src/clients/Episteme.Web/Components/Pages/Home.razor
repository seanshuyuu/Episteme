    private async Task RefreshFolderAsync(string folder)
    {
        var projectId = SelectedProject?.Id ?? CurrentWorkspace!.Id;
        var nodes = RootNodes;
        RootNodes.Clear();
        var root = await Api.ListDirectoryAsync(projectId, "", _disposeToken.Token);
        await AddTreeEntriesAsync(projectId, "", root, RootNodes, _disposeToken.Token);
        nodes = RootNodes;
        foreach (var segment in folder.Split('/', StringSplitOptions.RemoveEmptyEntries))
        {
            var node = nodes.SingleOrDefault(item => item.IsDirectory && item.Name == segment)
                ?? throw new InvalidOperationException("The selected directory no longer exists.");
            var response = await Api.ListDirectoryAsync(ActiveProjectId, node.Path, _disposeToken.Token);
            await AddTreeEntriesAsync(ActiveProjectId, node.Path, response, node.Children, _disposeToken.Token);
            node.IsLoaded = true;
            node.IsExpanded = true;
            SelectedFolderPath = node.Path;
            SelectedTreePath = node.Path;
            nodes = node.Children;
        }
    }

    private bool CanMudDrop(WorkspaceTreeNode source, string destinationFolder)
    {
        if (!CanWrite || IsMoving || IsTransferring)
            return false;
        if (ParentPath(source.Path) == destinationFolder)
            return false;
        if (source.IsDirectory && (destinationFolder == source.Path ||
            destinationFolder.StartsWith(source.Path + "/", StringComparison.Ordinal)))
            return false;
        return true;
    }

    private async Task OnMudTreeItemDropped(MudItemDropInfo<WorkspaceTreeNode> drop)
    {
        if (CurrentWorkspace is null)
            return;
        var source = drop.Item;
        if (source is null)
            return;
        var destinationFolder = drop.DropzoneIdentifier;
        if (!CanMudDrop(source, destinationFolder))
            return;
        if (SelectedTreePaths.Contains(source.Path) && SelectedTreePaths.Count > 1)
        {
            await MoveSelectedTreeEntriesAsync(destinationFolder);
            return;
        }
        await MoveTreeEntryAsync(ActiveProjectId, source, destinationFolder);
    }

    private Task OnTreeSelectionChanged((WorkspaceTreeNode Node, bool Selected) change)
    {
        if (change.Selected)
            SelectedTreePaths.Add(change.Node.Path);
        else
            SelectedTreePaths.Remove(change.Node.Path);
        return Task.CompletedTask;
    }

    private async Task MoveSelectedTreeEntriesAsync(string destinationFolder)
    {
        if (!CanWrite || IsMoving)
            return;
        var nodes = FlattenNodes(RootNodes)
            .Where(node => SelectedTreePaths.Contains(node.Path))
            .Where(node => !SelectedTreePaths.Any(path =>
                path != node.Path &&
                node.Path.StartsWith(path + "/", StringComparison.Ordinal)))
            .OrderBy(node => node.Path.Count(character => character == '/'))
            .ToList();
        if (nodes.Count == 0)
            return;
        IsMoving = true;
        try
        {
            var listing = await Api.ListDirectoryAsync(ActiveProjectId, destinationFolder, _disposeToken.Token);
            var head = listing.CommitId;
            foreach (var node in nodes)
            {
                var target = destinationFolder.Length == 0 ? node.Name : $"{destinationFolder}/{node.Name}";
                var request = new MoveWorkspacePathRequest(head, target);
                if (node.IsDirectory)
                    await Api.MoveDirectoryAsync(ActiveProjectId, node.Path, request, _disposeToken.Token);
                else
                    await Api.MoveDocumentAsync(ActiveProjectId, node.Path, request, _disposeToken.Token);
                var refreshed = await Api.ListDirectoryAsync(ActiveProjectId, destinationFolder, _disposeToken.Token);
                head = refreshed.CommitId;
            }
            SelectedTreePaths.Clear();
            await RefreshFolderAsync(destinationFolder);
            ShowToast($"已批量移动 {nodes.Count} 个项目。");
        }
        catch (ApiException exception)
        {
            ErrorMessage = $"批量移动失败：{ApiError(exception)}";
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "批量移动失败：无法连接到 Episteme API。";
        }
        catch (InvalidOperationException exception)
        {
            ErrorMessage = $"批量移动失败：{exception.Message}";
        }
        finally
        {
            IsMoving = false;
        }
    }

    private async Task MoveTreeEntryAsync(Guid workspaceId, WorkspaceTreeNode source, string destinationFolder)
    {
        ErrorMessage = "";
        if (!CanWrite || IsMoving || IsTransferring)
        {
            ErrorMessage = "无法移动：工作空间或权限已变化，或其他操作正在进行。";
            return;
        }
        if (CurrentDocument is not null && !IsReadOnlyVersion && EditedContent != CurrentDocument.Content)
        {
            ErrorMessage = "请先保存当前文档的未保存更改，再移动项目。";
            return;
        }
        IsMoving = true;
        var moved = false;
        try
        {
            var listing = await Api.ListDirectoryAsync(workspaceId, destinationFolder, _disposeToken.Token);
            var target = destinationFolder.Length == 0 ? source.Name : $"{destinationFolder}/{source.Name}";
            var request = new MoveWorkspacePathRequest(listing.CommitId, target);
            if (source.IsDirectory)
                await Api.MoveDirectoryAsync(workspaceId, source.Path, request, _disposeToken.Token);
            else
                await Api.MoveDocumentAsync(workspaceId, source.Path, request, _disposeToken.Token);
            moved = true;
            await RefreshFolderAsync(destinationFolder);
            ShowToast($"已移动到 /{destinationFolder}。");
        }
        catch (ApiException exception)
        {
            ErrorMessage = moved ? $"移动已完成，但刷新目录失败：{ApiError(exception)}" : $"移动失败：{ApiError(exception)}";
        }
        catch (HttpRequestException)
        {
            ErrorMessage = moved ? "移动已完成，但刷新目录失败：无法连接到 Episteme API。" : "移动请求未确认：无法连接到 Episteme API，请刷新目录检查结果。";
        }
        catch (InvalidOperationException exception)
        {
            ErrorMessage = moved ? $"移动已完成，但刷新目录失败：{exception.Message}" : $"移动失败：{exception.Message}";
        }
        finally
        {
            IsMoving = false;
        }
    }

    private Task UploadDocumentsAsync(InputFileChangeEventArgs args) => UploadAsync(args, false);

    private Task UploadFolderAsync(InputFileChangeEventArgs args) => UploadAsync(args, true);

    private async Task UploadAsync(InputFileChangeEventArgs args, bool isFolder)
    {
        if (CurrentWorkspace is null || !CanWrite || IsTransferring)
            return;
        IsTransferring = true;
        var uploaded = 0;
        var directoriesCreated = 0;
        var folder = SelectedFolderPath;
        var workspaceId = ActiveProjectId;
        ErrorMessage = "";
        try
        {
            var files = args.GetMultipleFiles(100);
            UploadTotal = files.Count;
            UploadCompleted = 0;
            UploadCurrentFile = "";
            await InvokeAsync(StateHasChanged);
            var relativePaths = isFolder
                ? await JS.InvokeAsync<string[]>("episteme.getRelativePaths", FolderUploadInput!.Element)
                : files.Select(file => file.Name).ToArray();
            if (relativePaths.Length != files.Count)
                throw new InvalidOperationException("无法读取上传文件夹的相对路径。");
            var listing = await Api.ListDirectoryAsync(workspaceId, folder, _disposeToken.Token);
            var head = listing.CommitId;
            for (var index = 0; index < files.Count; index++)
            {
                var file = files[index];
                UploadCurrentFile = file.Name;
                await InvokeAsync(StateHasChanged);
                var segments = relativePaths[index].Split('/');
                if (segments.Any(segment => segment.Length == 0 || segment is "." or "..") ||
                    segments[^1] != file.Name)
                    throw new InvalidOperationException("上传路径无效。");
                var parent = folder;
                foreach (var segment in segments[..^1])
                {
                    var directory = await Api.ListDirectoryAsync(workspaceId, parent, _disposeToken.Token);
                    if (directory.CommitId != head)
                        throw new InvalidOperationException("工作空间在上传期间发生变化，请重试。");
                    var existing = directory.Entries.FirstOrDefault(entry => entry.Name == segment);
                    var next = parent.Length == 0 ? segment : $"{parent}/{segment}";
                    if (existing is null)
                    {
                        var created = await Api.CreateDirectoryAsync(workspaceId, next,
                            new DeleteWorkspaceDocumentRequest(head), _disposeToken.Token);
                        head = created.CommitId;
                        directoriesCreated++;
                    }
                    else if (!existing.Kind.Equals("directory", StringComparison.OrdinalIgnoreCase))
                        throw new InvalidOperationException($"上传目录与现有项目冲突：{next}。");
                    parent = next;
                }
                await using var input = file.OpenReadStream(1024 * 1024, _disposeToken.Token);
                using var buffer = new MemoryStream();
                await input.CopyToAsync(buffer, _disposeToken.Token);
                var path = parent.Length == 0 ? file.Name : $"{parent}/{file.Name}";
                var commit = await Api.UploadDocumentAsync(workspaceId, path,
                    new PutWorkspaceBinaryDocumentRequest(head, buffer.ToArray()), _disposeToken.Token);
                head = commit.CommitId;
                uploaded++;
                UploadCompleted = uploaded;
                await InvokeAsync(StateHasChanged);
            }
            ShowToast($"已上传 {uploaded} 个文件。");
        }
        catch (ApiException exception)
        {
            ErrorMessage = $"已上传 {uploaded} 个文件，创建 {directoriesCreated} 个文件夹。{ApiError(exception)}";
        }
        catch (IOException)
        {
            ErrorMessage = $"已上传 {uploaded} 个文件，创建 {directoriesCreated} 个文件夹。读取文件失败；每个文件不能超过 1 MiB。";
        }
        catch (InvalidOperationException exception)
        {
            ErrorMessage = $"已上传 {uploaded} 个文件，创建 {directoriesCreated} 个文件夹。{exception.Message}";
        }
        catch (HttpRequestException)
        {
            ErrorMessage = $"已上传 {uploaded} 个文件，创建 {directoriesCreated} 个文件夹。无法连接到 Episteme API。";
        }
        catch (JSException)
        {
            ErrorMessage = $"已上传 {uploaded} 个文件，创建 {directoriesCreated} 个文件夹。无法读取上传文件夹的相对路径。";
        }
        finally
        {
            try
            {
                if ((uploaded > 0 || directoriesCreated > 0) && CurrentWorkspace?.Id == workspaceId)
                    await RefreshFolderAsync(folder);
            }
            catch (ApiException exception)
            {
                ErrorMessage += $" 刷新目录失败：{ApiError(exception)}";
            }
            catch (HttpRequestException)
            {
                ErrorMessage += " 刷新目录失败：无法连接到 Episteme API。";
            }
            catch (InvalidOperationException exception)
            {
                ErrorMessage += $" 刷新目录失败：{exception.Message}";
            }
            finally
            {
                IsTransferring = false;
                UploadTotal = 0;
                UploadCurrentFile = "";
                UploadInputVersion++;
            }
        }
    }

    private async Task DownloadDocumentAsync()
    {
        if (CurrentWorkspace is null || SelectedFile is null || IsTransferring)
            return;
        IsTransferring = true;
        var workspaceId = ActiveProjectId;
        var file = SelectedFile;
        try
        {
            await RunApiAsync(async () =>
            {
                var document = await Api.DownloadDocumentAsync(workspaceId, file.Path, _disposeToken.Token);
                await JS.InvokeVoidAsync("episteme.downloadBytes", file.Name, document.Content, "application/octet-stream");
            });
        }
        catch (JSException)
        {
            ErrorMessage = "浏览器下载失败，请重试。";
        }
        finally
        {
            IsTransferring = false;
        }
    }

    private async Task DownloadWorkspaceAsync()
    {
        if (CurrentWorkspace is null || IsTransferring)
            return;
        IsTransferring = true;
        var workspaceId = ActiveProjectId;
        var workspaceName = CurrentWorkspace.Name;
        try
        {
            await RunApiAsync(async () =>
            {
                using var output = new MemoryStream();
                var root = await Api.ListDirectoryAsync(workspaceId, "", _disposeToken.Token);
                var entries = 0;
                long totalBytes = 0;
                using (var zip = new ZipArchive(output, ZipArchiveMode.Create, leaveOpen: true))
                {
                    async Task AddDirectoryAsync(string path, WorkspaceDirectoryResponse listing)
                    {
                        if (listing.CommitId != root.CommitId)
                            throw new InvalidOperationException("工作空间在下载期间发生变化，请重试。");
                        foreach (var entry in listing.Entries)
                        {
                            if (++entries > 1000)
                                throw new InvalidOperationException("工作空间超过 ZIP 下载的 1000 项限制。");
                            var child = path.Length == 0 ? entry.Name : $"{path}/{entry.Name}";
                            if (entry.Kind.Equals("directory", StringComparison.OrdinalIgnoreCase))
                            {
                                zip.CreateEntry(child + "/");
                                var directory = await Api.ListDirectoryAsync(workspaceId, child, _disposeToken.Token);
                                await AddDirectoryAsync(child, directory);
                            }
                            else if (entry.Kind.Equals("document", StringComparison.OrdinalIgnoreCase))
                            {
                                var document = await Api.DownloadDocumentAsync(workspaceId, child, _disposeToken.Token);
                                if (document.CommitId != root.CommitId)
                                    throw new InvalidOperationException("工作空间在下载期间发生变化，请重试。");
                                totalBytes += document.Content.Length;
                                if (totalBytes > 32 * 1024 * 1024)
                                    throw new InvalidOperationException("工作空间超过 ZIP 下载的 32 MiB 限制。");
                                using var stream = zip.CreateEntry(child).Open();
                                await stream.WriteAsync(document.Content, _disposeToken.Token);
                            }
                            else
                                throw new InvalidOperationException($"不支持下载项目：{child}（{entry.Kind}）。");
                        }
                    }
                    await AddDirectoryAsync("", root);
                }
                await JS.InvokeVoidAsync("episteme.downloadBytes", $"{workspaceName}.zip", output.ToArray(), "application/zip");
            });
        }
        catch (InvalidOperationException exception)
        {
            ErrorMessage = exception.Message;
        }
        catch (JSException)
        {
            ErrorMessage = "浏览器下载失败，请重试。";
        }
        finally
        {
            IsTransferring = false;
        }
    }

    private void ToggleMarkdownPreview() => ShowMarkdownPreview = !ShowMarkdownPreview;

    private void ShowScreen(string screen)
    {
        Screen = screen;
        ErrorMessage = "";
    }

    private void SelectRootFolder()
    {
        SelectedFolderPath = "";
        SelectedTreePath = null;
    }

    private void CloseDialog() => IsDialogOpen = false;
    private async Task SetAccentAsync(string accent)
    {
        ThemePreferences = ThemePreferences with { Accent = accent };
        await SaveThemeAsync();
    }
    private Task SaveThemeAsync() => Theme.SaveAsync(ThemePreferences, _disposeToken.Token).AsTask();
    private async Task ResetThemeAsync()
    {
        ThemePreferences = ThemePreferences.Default;
        await SaveThemeAsync();
    }

    private async Task RunApiAsync(Func<Task> action, bool dialog = false)
    {
        ErrorMessage = "";
        if (dialog)
            DialogError = "";
        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            var message = ApiError(exception);
            if (dialog)
                DialogError = message;
            else
                ErrorMessage = message;
        }
        catch (HttpRequestException)
        {
            const string message = "无法连接到 Episteme API。请检查 API 地址和服务状态。";
            if (dialog)
                DialogError = message;
            else
                ErrorMessage = message;
        }
    }

    private void ShowToast(string message)
    {
        ToastMessage = message;
        _ = ClearToastAsync();
    }

    private async Task ClearToastAsync()
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), _disposeToken.Token);
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
            return;
        }
        if (!IsDisposed)
        {
            ToastMessage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string ApiError(ApiException exception) =>
        $"请求失败（HTTP {(int)exception.StatusCode} {exception.StatusCode}）。请检查权限、输入或并发版本后重试。";
    private static string RoleLabel(string? role) => role switch
    {
        "Owner" => "Owner",
        "Editor" => "读写 · Editor",
        "Reader" => "只读 · Reader",
        _ => "权限未提供"
    };
    private static string StatusLabel(string? status) => status switch
    {
        "Active" => "正常 · Active",
        "Provisioning" => "初始化中 · Provisioning",
        "Archived" => "已归档 · Archived",
        _ => $"未知状态 · {status}"
    };
    private static string ParentPath(string path)
    {
        var index = path.LastIndexOf('/');
        return index < 0 ? "" : path[..index];
    }
    private static IEnumerable<WorkspaceTreeNode> FlattenNodes(IEnumerable<WorkspaceTreeNode> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var descendant in FlattenNodes(node.Children))
                yield return descendant;
        }
    }
    private static bool IsEditableTextFile(string name) =>
        name.EndsWith(".txt", StringComparison.OrdinalIgnoreCase) ||
        name.EndsWith(".md", StringComparison.OrdinalIgnoreCase) ||
        IsSourceFile(name);
    private static bool IsSourceFile(string name) =>
        Path.GetExtension(name).ToLowerInvariant() is ".cs" or ".js" or ".ts" or ".json" or ".xml" or ".yml" or ".yaml";
    private static string ShortCommit(string commit) => commit.Length > 7 ? commit[..7] : commit;

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor) =>
        new()
        {
            AutomaticLayout = true,
            ReadOnly = IsReadOnlyVersion,
            Language = MonacoLanguage,
            Value = EditedContent,
            Minimap = new EditorMinimapOptions { Enabled = false },
            ScrollBeyondLastLine = false
        };

    private string MonacoLanguage => SelectedFile?.Name.Split('.').LastOrDefault()?.ToLowerInvariant() switch
    {
        "cs" => "csharp",
        "js" => "javascript",
        "ts" => "typescript",
        "json" => "json",
        "xml" => "xml",
        "yml" or "yaml" => "yaml",
        "md" => "markdown",
        "txt" => "plaintext",
        _ => "plaintext"
    };

    public async ValueTask DisposeAsync()
    {
        IsDisposed = true;
        _disposeToken.Cancel();
        _disposeToken.Dispose();
    }
}
