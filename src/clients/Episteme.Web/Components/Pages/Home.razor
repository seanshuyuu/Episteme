    private async Task RenameEntryAsync()
    {
        if (CurrentWorkspace is null || DialogTreeNode is null)
            return;
        var name = WorkspaceName.Trim();
        if (name.Length == 0)
        {
            DialogError = "请输入新名称。";
            return;
        }
        if (name is "." or ".." || name.Contains('/') || name.Contains('\\'))
        {
            DialogError = "名称不能包含路径分隔符或特殊相对路径。";
            return;
        }
        var oldPath = DialogTreeNode.Path;
        if (name == DialogTreeNode.Name)
        {
            IsDialogOpen = false;
            return;
        }
        var parent = ParentPath(oldPath);
        var destination = parent.Length == 0 ? name : $"{parent}/{name}";
        await RunApiAsync(async () =>
        {
            var listing = await Api.ListDirectoryAsync(ActiveProjectId, parent, _disposeToken.Token);
            var request = new MoveWorkspacePathRequest(listing.CommitId, destination);
            if (DialogTreeNode.IsDirectory)
                await Api.MoveDirectoryAsync(ActiveProjectId, oldPath, request, _disposeToken.Token);
            else
                await Api.MoveDocumentAsync(ActiveProjectId, oldPath, request, _disposeToken.Token);
            IsDialogOpen = false;
            await RefreshFolderAsync(parent);
            if (SelectedFile?.Path == oldPath)
            {
                SelectedFile = null;
                CurrentDocument = null;
                EditedContent = "";
                IsReadOnlyVersion = false;
            }
            ShowToast($"已重命名为 {name}。");
        }, dialog: true);
    }

