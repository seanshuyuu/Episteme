    private void OpenManageWorkspace(WorkspaceResponse workspace)
    {
        DialogWorkspace = workspace;
        DialogKind = "manage";
        DialogTitle = $"设置 · {workspace.Name}";
        DialogSubtitle = "空间元数据使用并发版本戳保护。";
        WorkspaceName = workspace.Name;
        WorkspaceType = workspace.Type;
        WorkspaceDescription = workspace.Description ?? "";
        DialogError = "";
        IsDialogOpen = true;
    }

    private async Task SaveWorkspaceAsync()
    {
        await RunApiAsync(async () =>
        {
            if (DialogKind == "create")
            {
                var created = await Api.CreateWorkspaceAsync(new CreateWorkspaceRequest(
                    WorkspaceName, WorkspaceSlug, WorkspaceType, WorkspaceDescription), _disposeToken.Token);
                await LoadWorkspacesAsync(_disposeToken.Token);
                CurrentWorkspace = Workspaces.First(workspace => workspace.Id == created.Id);
                await LoadWorkspaceAsync(CurrentWorkspace, _disposeToken.Token);
                ShowToast("工作空间已创建。");
            }
            else
            {
                if (DialogWorkspace is null)
                    throw new InvalidOperationException("The workspace being edited is no longer available.");
                var updated = await Api.UpdateWorkspaceAsync(DialogWorkspace.Id, new UpdateWorkspaceRequest(
                    WorkspaceName, WorkspaceType, WorkspaceDescription, DialogWorkspace.ConcurrencyStamp), _disposeToken.Token);
                await LoadWorkspacesAsync(_disposeToken.Token);
                if (CurrentWorkspace?.Id == updated.Id)
                    CurrentWorkspace = updated;
                await LoadWorkspaceAsync(CurrentWorkspace!, _disposeToken.Token);
                ShowToast("工作空间设置已保存。");
            }
            IsDialogOpen = false;
        }, dialog: true);
    }

    private void OpenImportWorkspace()
    {
        DialogKind = "import";
        DialogTitle = "导入工作空间配置";
        DialogSubtitle = "导入非敏感元数据和可选的空目录骨架。";
        ImportManifest = null;
        ImportName = "";
        ImportSlug = "";
        DialogError = "";
        IsDialogOpen = true;
    }

    private async Task ReadManifestAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await using var stream = args.File.OpenReadStream(1_048_576, _disposeToken.Token);
            ImportManifest = await JsonSerializer.DeserializeAsync<WorkspaceManifestResponse>(
                stream, new JsonSerializerOptions(JsonSerializerDefaults.Web), _disposeToken.Token);
            if (ImportManifest is null)
            {
                DialogError = "配置文件内容为空。";
                return;
            }
            ImportName = ImportManifest.Name;
            DialogError = "";
        }
        catch (JsonException)
        {
            DialogError = "配置文件不是有效的 Episteme JSON manifest。";
        }
        catch (IOException)
        {
            DialogError = "读取配置文件失败。";
        }
    }

    private async Task ImportWorkspaceAsync()
    {
        if (ImportManifest is null)
            return;
        await RunApiAsync(async () =>
        {
            var manifest = ImportManifest with { Name = ImportName };
            var imported = await Api.ImportWorkspaceManifestAsync(new ImportWorkspaceManifestRequest(ImportSlug, manifest), _disposeToken.Token);
            IsDialogOpen = false;
            await LoadWorkspacesAsync(_disposeToken.Token);
            CurrentWorkspace = Workspaces.First(workspace => workspace.Id == imported.Id);
            await LoadWorkspaceAsync(CurrentWorkspace, _disposeToken.Token);
            ShowToast("工作空间配置已导入。");
        }, dialog: true);
    }

    private async Task ExportManifestAsync(WorkspaceResponse workspace)
    {
        await RunApiAsync(async () =>
        {
            var manifest = await Api.ExportWorkspaceManifestV3Async(workspace.Id, _disposeToken.Token);
            var json = JsonSerializer.Serialize(manifest, new JsonSerializerOptions(JsonSerializerDefaults.Web) { WriteIndented = true });
            await JS.InvokeVoidAsync("episteme.downloadText", $"{workspace.Slug}.episteme.workspace.json", json, "application/json");
        });
    }

    private void ConfirmArchive(WorkspaceResponse workspace)
    {
        DialogWorkspace = workspace;
        WorkspaceName = workspace.Name;
        DialogKind = "archive";
        DialogTitle = "确认归档空间";
        DialogSubtitle = "归档保留仓库及 Git 历史。";
        DialogError = "";
        IsDialogOpen = true;
    }

    private async Task ArchiveWorkspaceAsync()
    {
        if (DialogWorkspace is null)
            return;
        var archivedId = DialogWorkspace.Id;
        await RunApiAsync(async () =>
        {
            await Api.ArchiveWorkspaceAsync(archivedId,
                new ArchiveWorkspaceRequest(DialogWorkspace.ConcurrencyStamp), _disposeToken.Token);
            IsDialogOpen = false;
            await LoadWorkspacesAsync(_disposeToken.Token);
            if (CurrentWorkspace is not null)
                await LoadWorkspaceAsync(CurrentWorkspace, _disposeToken.Token);
            ShowToast("工作空间已归档。");
        }, dialog: true);
    }

    private void OpenCreateEntry(bool folder)
    {
        DialogKind = folder ? "create-folder" : "create-document";
        DialogTitle = folder ? "新建文件夹" : "新建文档";
        DialogSubtitle = $"创建位置：/{SelectedFolderPath}";
        WorkspaceName = "";
        DialogError = "";
        IsDialogOpen = true;
    }

    private async Task CreateEntryAsync()
    {
        if (CurrentWorkspace is null)
            return;
        if (string.IsNullOrWhiteSpace(WorkspaceName))
        {
            DialogError = "请输入名称。";
            return;
        }
        var name = WorkspaceName.Trim();
        await RunApiAsync(async () =>
        {
            var expectedHead = await Api.ListDirectoryAsync(CurrentWorkspace.Id, SelectedFolderPath, _disposeToken.Token);
            var path = string.IsNullOrEmpty(SelectedFolderPath) ? name : $"{SelectedFolderPath}/{name}";
            if (DialogKind == "create-folder")
            {
                await Api.CreateDirectoryAsync(CurrentWorkspace.Id, path,
                    new DeleteWorkspaceDocumentRequest(expectedHead.CommitId), _disposeToken.Token);
            }
            else
            {
                path += NewDocumentExtension;
                await Api.PutDocumentAsync(CurrentWorkspace.Id, path,
                    new PutWorkspaceDocumentRequest(expectedHead.CommitId, ""), _disposeToken.Token);
            }
            IsDialogOpen = false;
            await LoadWorkspaceAsync(CurrentWorkspace, _disposeToken.Token);
        }, dialog: true);
    }

    private void ToggleMarkdownPreview() => ShowMarkdownPreview = !ShowMarkdownPreview;

    private void ShowScreen(string screen)
    {
        Screen = screen;
        ErrorMessage = "";
    }

    private void SelectRootFolder()
    {
        SelectedFolderPath = "";
        SelectedTreePath = null;
    }

    private void CloseDialog() => IsDialogOpen = false;
    private async Task SetAccentAsync(string accent)
    {
        ThemePreferences = ThemePreferences with { Accent = accent };
        await SaveThemeAsync();
    }
    private Task SaveThemeAsync() => Theme.SaveAsync(ThemePreferences, _disposeToken.Token).AsTask();
    private async Task ResetThemeAsync()
    {
        ThemePreferences = ThemePreferences.Default;
        await SaveThemeAsync();
    }

    private async Task RunApiAsync(Func<Task> action, bool dialog = false)
    {
        ErrorMessage = "";
        if (dialog)
            DialogError = "";
        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            var message = ApiError(exception);
            if (dialog)
                DialogError = message;
            else
                ErrorMessage = message;
        }
        catch (HttpRequestException)
        {
            const string message = "无法连接到 Episteme API。请检查 API 地址和服务状态。";
            if (dialog)
                DialogError = message;
            else
                ErrorMessage = message;
        }
    }

    private void ShowToast(string message)
    {
        ToastMessage = message;
        _ = ClearToastAsync();
    }

    private async Task ClearToastAsync()
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), _disposeToken.Token);
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
            return;
        }
        if (!IsDisposed)
        {
            ToastMessage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string ApiError(ApiException exception) =>
        $"请求失败（HTTP {(int)exception.StatusCode} {exception.StatusCode}）。请检查权限、输入或并发版本后重试。";
    private static string RoleLabel(string? role) => role switch
    {
        "Owner" => "Owner",
        "Editor" => "读写 · Editor",
        "Reader" => "只读 · Reader",
        _ => "权限未提供"
    };
    private static string StatusLabel(string? status) => status switch
    {
        "Active" => "正常 · Active",
        "Provisioning" => "初始化中 · Provisioning",
        "Archived" => "已归档 · Archived",
        _ => $"未知状态 · {status}"
    };
    private static string ParentPath(string path)
    {
        var index = path.LastIndexOf('/');
        return index < 0 ? "" : path[..index];
    }
    private static IEnumerable<WorkspaceTreeNode> FlattenNodes(IEnumerable<WorkspaceTreeNode> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var descendant in FlattenNodes(node.Children))
                yield return descendant;
        }
    }
    private static bool IsEditableTextFile(string name) =>
        name.EndsWith(".txt", StringComparison.OrdinalIgnoreCase) ||
        name.EndsWith(".md", StringComparison.OrdinalIgnoreCase) ||
        IsSourceFile(name);
    private static bool IsSourceFile(string name) =>
        Path.GetExtension(name).ToLowerInvariant() is ".cs" or ".js" or ".ts" or ".json" or ".xml" or ".yml" or ".yaml";
    private static string ShortCommit(string commit) => commit.Length > 7 ? commit[..7] : commit;

    public ValueTask DisposeAsync()
    {
        IsDisposed = true;
        _disposeToken.Cancel();
        _disposeToken.Dispose();
        return ValueTask.CompletedTask;
    }
}
