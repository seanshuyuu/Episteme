    private void OpenNewWorkspace()
    {
        DialogKind = "create";
        DialogTitle = "新建工作空间";
        DialogSubtitle = "正式创建后将初始化独立 Git 仓库。";
        WorkspaceName = "";
        WorkspaceSlug = "";
        WorkspaceType = "Code";
        WorkspaceDescription = "";
        DialogError = "";
        IsDialogOpen = true;
