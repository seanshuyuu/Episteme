<MudTreeViewItem T="WorkspaceTreeNode"
                 Value="@Node"
                 Text="@Node.Name"
                 Icon="@(Node.IsDirectory ? Icons.Material.Filled.Folder : Icons.Material.Filled.InsertDriveFile)"
                 IconExpanded="@(Node.IsDirectory ? Icons.Material.Filled.FolderOpen : Icons.Material.Filled.InsertDriveFile)"
                 Selected="@(CurrentPath == Node.Path)"
                 Expanded="@Node.IsExpanded"
                 Disabled="@IsMoving"
                 SelectedChanged="SelectedChangedAsync"
                 ExpandedChanged="ExpandedChangedAsync">
    @if (Node.IsDirectory)
    {
        @foreach (var child in Node.Children)
        {
            <TreeNode @key="child.Path" Node="child" CurrentPath="CurrentPath"
                      CanMove="CanMove" IsMoving="IsMoving" OnSelect="OnSelect" OnToggleDirectory="OnToggleDirectory" />
        }
    }
</MudTreeViewItem>

@code {
    [Parameter, EditorRequired] public WorkspaceTreeNode Node { get; set; } = null!;
    [Parameter] public string? CurrentPath { get; set; }
    [Parameter] public bool CanMove { get; set; }
    [Parameter] public bool IsMoving { get; set; }
    [Parameter] public EventCallback<WorkspaceTreeNode> OnSelect { get; set; }
    [Parameter] public EventCallback<WorkspaceTreeNode> OnToggleDirectory { get; set; }

    private Task SelectedChangedAsync(bool selected)
        => selected
            ? (Node.IsDirectory ? OnToggleDirectory.InvokeAsync(Node) : OnSelect.InvokeAsync(Node))
            : Task.CompletedTask;

    private Task ExpandedChangedAsync(bool expanded)
    {
        Node.IsExpanded = expanded;
        return Node.IsDirectory && expanded && !Node.IsLoaded
            ? OnToggleDirectory.InvokeAsync(Node)
            : Task.CompletedTask;
    }
}
