@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var returnUrl = Request.Query["returnUrl"].ToString();
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>确认邮箱 - Episteme</title>
    <link rel="stylesheet" href="~/css/auth-login.css" asp-append-version="true" />
</head>
<body>
    <main class="login-shell">
        <div class="login-container">
            <header class="brand"><span class="brand-mark" aria-hidden="true">E</span><span>Episteme</span></header>
            <div class="login-card">
                @await Html.PartialAsync("/Areas/Identity/Pages/Account/_AuthIntro.cshtml")
                <section class="login-panel" aria-labelledby="confirmation-title">
                    <div class="panel-heading">
                        <span class="eyebrow">完成注册</span>
                        <h2 id="confirmation-title">请检查邮箱</h2>
                        <p>如果注册成功，请打开确认邮件中的链接，然后返回登录。</p>
                    </div>
                    <div class="account-links"><a asp-page="./Login" asp-route-returnUrl="@returnUrl">返回登录</a></div>
                </section>
            </div>
            <p class="footer">Episteme · 你的知识工作空间</p>
        </div>
    </main>
</body>
</html>
