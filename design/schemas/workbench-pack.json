        { "key": "complianceChecked", "label": "合规校验", "type": "select", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": false, "options": ["通过", "需改写", "阻断"] },
        { "key": "collectedAt", "label": "采集日期", "type": "date", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": false }
