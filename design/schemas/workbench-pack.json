  "views": [
    { "name": "今日热点 Top50", "node": "/M11-每日全网热点库/每日", "sort": [{ "field": "rank", "desc": false }], "limit": 50 },
    { "name": "拆文复盘对话", "type": "chat", "prompts": ["teardown_full"] },
    { "name": "每日热点日报", "type": "report", "template": "daily_hotspots" }
  ],
  "prompts": [
    { "id": "teardown_full", "name": "口令 1 · 全自动拆文入库", "template": "输入短篇全文 → 输出全维度拆文报告（M1–M10 字段化结论）+ 仿写公式 + 改写方案 → 自动归类写入 1–10 模块并生成 M6 报告" },
    { "id": "daily_hotspots", "name": "口令 2 · 每日热点日报", "template": "采集 50 条有效热点 → 过滤时政/敏感/娱乐/广告 → 6 项强制转化 + 3 个标题模板 → 生成日报" },
    { "id": "fact_blur", "name": "事实虚化改编", "template": "去真人真事、去可识别信息，仅保留戏剧冲突与人性梗，生成前后双重合规校验" }
  ],
  "jobs": [
    { "id": "daily_hotspots", "cron": "0 0 7 * * ?", "timezone": "Asia/Shanghai", "type": "import", "target": "/M11-每日全网热点库/每日", "limit": 50, "sources": ["微博", "知乎", "头条民生"] }
