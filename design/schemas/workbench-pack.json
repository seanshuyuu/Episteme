        { "key": "sourceUrl", "label": "原文链接", "type": "url", "required": false, "indexed": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "videoUrl", "label": "原视频链接", "type": "url", "required": false, "indexed": false, "exposeToMcp": true, "mcpWritable": true },
        { "key": "fullText", "label": "新闻完整文字版", "type": "longtext", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "summary", "label": "① 热点精简梗概", "type": "longtext", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "emotionTag", "label": "② 赛道情绪标签", "type": "tags", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "dramaticConflict", "label": "③ 核心戏剧冲突", "type": "longtext", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
        { "key": "novelHook", "label": "④ 可直接使用的小说核心梗", "type": "longtext", "required": false, "indexed": true, "exposeToMcp": true, "mcpWritable": true },
