EPISTEME_BIND_IP=0.0.0.0
EPISTEME_HTTP_PORT=5080

# v0.5 opt-in production switches. Defaults keep the legacy/dev behaviour so existing regressions pass.
EPISTEME_AUTH_MODE=legacy
EPISTEME_AUTH_SECRET=
EPISTEME_DB_PROVIDER=sqlite
EPISTEME_PG_CONNECTION=
EPISTEME_PG_DB=episteme
EPISTEME_PG_USER=episteme
EPISTEME_PG_PASSWORD=episteme-local
EPISTEME_RATE_LIMIT=600
EPISTEME_SIGNATURE_SKEW=300

# fetch-worker is internal-only; leave the token empty unless the worker is exposed further.
EPISTEME_FETCH_TOKEN=
EPISTEME_FETCH_ALLOWLIST=
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:17-alpine
