# Episteme 账号体系（users 模式）配置样例
# 用法：把这些键合并进 deploy/.env，或以 docker compose --env-file 传入，然后重建 api 容器。
# 本文件只是占位样例，不含真实凭证；不要把真实 secret / 管理员密码提交到 Git。

EPISTEME_BIND_IP=0.0.0.0
EPISTEME_HTTP_PORT=5080

# 从 legacy 切到 users：启用注册/登录、全局角色、按空间授权、管理员后台
EPISTEME_AUTH_MODE=users

# 用 `openssl rand -hex 32` 生成；同时用于 JWT 签名与 HMAC 机器通道
EPISTEME_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# 首启种子管理员（仅在用户表为空时创建一次，之后改密码不会被覆盖）
EPISTEME_ADMIN_USER=admin
EPISTEME_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# 是否允许普通用户自助注册；false 时只能由管理员在后台创建账号
EPISTEME_ALLOW_REGISTRATION=true

# 令牌有效期（秒），默认 24 小时
EPISTEME_JWT_TTL_SECONDS=86400
EPISTEME_JWT_ISSUER=episteme
EPISTEME_JWT_AUDIENCE=episteme-clients

# 机器通道白名单：git-sync.py 的 --key-id / --role 必须与之匹配。
# 也可改用 --auth login --user <账号> --password <密码> 走真实账号。
EPISTEME_API_KEYS=git-sync:owner

EPISTEME_RATE_LIMIT=600
EPISTEME_SIGNATURE_SKEW=300
EPISTEME_DB_PROVIDER=sqlite
