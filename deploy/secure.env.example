# Episteme 公网 / 生产开关示例
# 用法：把下面的键合并进 deploy/.env（或作为 docker compose --env-file 传入），
#       然后 docker compose -f deploy/docker-compose.yml -p episteme up -d --force-recreate
# 注意：本文件只是占位样例，不含任何真实凭证；不要把真实 secret 提交到 Git。

# 默认保留 0.0.0.0，维持现有局域网直连；若只通过本机反代对外，
# 可收紧为 127.0.0.1，让 5080 不再直接暴露在局域网。
EPISTEME_BIND_IP=0.0.0.0
EPISTEME_HTTP_PORT=5080

# 关键：从 legacy 切到 secure，启用 JWT / HMAC / Nonce / 限流
EPISTEME_AUTH_MODE=secure

# 用 openssl rand -hex 32 生成，替换下面占位值
EPISTEME_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# 可选：API Key 白名单，格式 keyId:role（逗号分隔）。
# 配置后 git-sync.py 的 --key-id / --role 必须与之匹配。
EPISTEME_API_KEYS=git-sync:owner

# 每分钟请求数（固定窗口，全局生效）
EPISTEME_RATE_LIMIT=180

# 签名时间戳允许偏差（秒），同时决定 Nonce 重放窗口
EPISTEME_SIGNATURE_SKEW=300

# 可选：切到 PostgreSQL（需要启用 postgres profile）
# EPISTEME_DB_PROVIDER=postgres
# EPISTEME_PG_CONNECTION=Host=postgres;Port=5432;Database=episteme;Username=episteme;Password=...

# 可选：fetch-worker 调用令牌与域名白名单
# EPISTEME_FETCH_TOKEN=
# EPISTEME_FETCH_ALLOWLIST=example.com,docs.example.org
