# Episteme Compose 配置模板（不含任何真实凭证）
# 用法：cp deploy/.env.example deploy/.env，然后按需修改；.env 已被 .gitignore 忽略。
# 账号体系（users 模式）的完整变量清单见 deploy/users.env.example 与 README 第 11 节。

EPISTEME_BIND_IP=0.0.0.0
EPISTEME_HTTP_PORT=5080

# legacy = 无鉴权（仅本机/内网回归）；secure = JWT/HMAC 机器通道；users = 账号体系
# 本工作区交付态为 users；全新克隆若沿用 legacy，请务必先读 README 的安全提醒。
EPISTEME_AUTH_MODE=legacy
EPISTEME_AUTH_SECRET=
EPISTEME_API_KEYS=

# users 模式必填（改用 users 时设置；不要提交真实值）
# EPISTEME_ADMIN_USER=admin
# EPISTEME_ADMIN_PASSWORD=
# EPISTEME_ALLOW_REGISTRATION=true
# EPISTEME_JWT_TTL_SECONDS=86400
# EPISTEME_JWT_ISSUER=episteme
# EPISTEME_JWT_AUDIENCE=episteme-clients
# EPISTEME_LOGIN_RATE_LIMIT=30
# EPISTEME_MACHINE_SPACES=            # 可选：把 HMAC 机器密钥限定在指定空间（id/slug，逗号分隔）；留空 = 不限制

EPISTEME_DB_PROVIDER=sqlite
EPISTEME_PG_CONNECTION=
EPISTEME_PG_DB=episteme
EPISTEME_PG_USER=episteme
EPISTEME_PG_PASSWORD=episteme-local
EPISTEME_RATE_LIMIT=600
EPISTEME_SIGNATURE_SKEW=300

# fetch-worker 只在 compose 内网可达；除非另行暴露，否则 token 可留空
EPISTEME_FETCH_TOKEN=
EPISTEME_FETCH_ALLOWLIST=
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:17-alpine
